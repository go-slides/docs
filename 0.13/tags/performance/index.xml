&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;gaia, 20 slides&lt;/td&gt;
&lt;td style="text-align: right"&gt;93 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;1,546 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;285 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;32 KiB&lt;/td&gt;
&lt;td style="text-align: right"&gt;66 KiB&lt;/td&gt;
&lt;td style="text-align: right"&gt;582 KiB&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;math and code, 20 slides&lt;/td&gt;
&lt;td style="text-align: right"&gt;140 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;1,643 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;294 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;124 KiB&lt;/td&gt;
&lt;td style="text-align: right"&gt;335 KiB&lt;/td&gt;
