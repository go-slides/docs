&lt;tr&gt;
&lt;td&gt;100 slides&lt;/td&gt;
&lt;td style="text-align: right"&gt;306 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;1,763 ms&lt;/td&gt;
