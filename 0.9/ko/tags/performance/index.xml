&lt;td style="text-align: right"&gt;8.03 s&lt;/td&gt;
&lt;td style="text-align: right"&gt;530 MiB&lt;/td&gt;
&lt;td style="text-align: right"&gt;1,373 MiB&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;gaia, 슬라이드 20장&lt;/td&gt;
&lt;td&gt;PDF&lt;/td&gt;
&lt;td style="text-align: right"&gt;283 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;1.57 s&lt;/td&gt;
&lt;td style="text-align: right"&gt;154 MiB&lt;/td&gt;
