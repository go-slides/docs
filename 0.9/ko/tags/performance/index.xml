&lt;th style="text-align: right"&gt;marp-cli&lt;/th&gt;
&lt;th style="text-align: right"&gt;go-slides 메모리&lt;/th&gt;
&lt;th style="text-align: right"&gt;marp-cli 메모리&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;슬라이드 100장&lt;/td&gt;
&lt;td&gt;HTML&lt;/td&gt;
&lt;td style="text-align: right"&gt;36 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;315 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;47 MiB&lt;/td&gt;
&lt;td style="text-align: right"&gt;140 MiB&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;슬라이드 100장&lt;/td&gt;
&lt;td&gt;PDF&lt;/td&gt;
&lt;td style="text-align: right"&gt;1.14 s&lt;/td&gt;
