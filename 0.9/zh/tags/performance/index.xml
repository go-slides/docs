&lt;td style="text-align: right"&gt;4,608 ms&lt;/td&gt;
&lt;td style="text-align: right"&gt;893 KiB&lt;/td&gt;
&lt;td style="text-align: right"&gt;4.8 MiB&lt;/td&gt;
&lt;td style="text-align: right"&gt;&lt;/td&gt;
&lt;td style="text-align: right"&gt;&lt;/td&gt;
